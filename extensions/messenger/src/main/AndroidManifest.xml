        <meta-data android:name="hush.feature.external_browser" android:value="true" />
        <meta-data android:name="hush.feature.bubbles" android:value="true" />
        <provider android:name="app.hushmessenger.extension.SettingsProvider" android:authorities="${applicationId}.hush.settings" android:exported="false" />
        <activity android:name="app.hushmessenger.extension.SettingsActivity" android:label="HushMessenger settings" android:icon="@android:drawable/ic_menu_preferences" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
