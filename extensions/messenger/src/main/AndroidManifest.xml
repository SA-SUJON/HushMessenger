<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="HushMessenger settings" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <meta-data android:name="hush.feature.ads" android:value="true" />
        <meta-data android:name="hush.feature.people" android:value="true" />
        <meta-data android:name="hush.feature.friend_requests" android:value="true" />
        <meta-data android:name="hush.feature.growth" android:value="true" />
        <meta-data android:name="hush.feature.inbox_promotions" android:value="true" />
        <meta-data android:name="hush.feature.stories" android:value="true" />
        <meta-data android:name="hush.feature.subtabs" android:value="true" />
        <meta-data android:name="hush.feature.facebook" android:value="true" />
        <meta-data android:name="hush.feature.meta_ai" android:value="true" />
        <meta-data android:name="hush.feature.moments" android:value="true" />
        <meta-data android:name="hush.feature.reels_badge" android:value="true" />
        <meta-data android:name="hush.feature.ai_stickers" android:value="true" />
        <meta-data android:name="hush.feature.avatar_stickers" android:value="true" />
        <meta-data android:name="hush.feature.chat_promotions" android:value="true" />
        <meta-data android:name="hush.feature.suggested_replies" android:value="true" />
